{
  "version": 1,
  "voiceId": "jejak",
  "durationSec": 70.785,
  "master": true,
  "chunks": [
    {
      "index": 0,
      "tag": null,
      "text": "Di luar pintu mobilmu, ada zombie.",
      "start": 0,
      "end": 2.585,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 1,
      "tag": null,
      "text": "Kalau kamu keluar sekarang, mereka akan melihatmu.",
      "start": 2.745,
      "end": 5.23,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 2,
      "tag": null,
      "text": "Wabah baru saja mencapai jalan tol. Orang-orang meninggalkan mobil dan berlari.",
      "start": 5.39,
      "end": 10.755,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 3,
      "tag": null,
      "text": "Kamu meraih gagang pintu.",
      "start": 10.915,
      "end": 12.48,
      "retries": 2,
      "status": "accepted-with-warnings"
    },
    {
      "index": 4,
      "tag": null,
      "text": "Tiba-tiba, seorang pengendara diterkam tepat di depanmu.",
      "start": 12.64,
      "end": 16.505,
      "retries": 2,
      "status": "accepted-with-warnings"
    },
    {
      "index": 5,
      "tag": null,
      "text": "Kamu menarik tanganmu dan mengunci pintu.",
      "start": 16.665,
      "end": 19.45,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 6,
      "tag": null,
      "text": "Mobil di depan dan belakangmu tidak bergerak. Kamu terjebak.",
      "start": 19.61,
      "end": 23.795,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 7,
      "tag": null,
      "text": "Saat matahari terbenam, kamu mematikan mesin, lampu, dan radio.",
      "start": 23.955,
      "end": 28.46,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 8,
      "tag": null,
      "text": "Lalu, kamu merunduk di bawah jendela.",
      "start": 28.62,
      "end": 30.805,
      "retries": 2,
      "status": "accepted-with-warnings"
    },
    {
      "index": 9,
      "tag": null,
      "text": "Langkah kaki mendekat.",
      "start": 30.965,
      "end": 32.13,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 10,
      "tag": null,
      "text": "Seseorang berhenti di samping mobilmu. Bayangannya menutupi jendela.",
      "start": 32.29,
      "end": 35.995,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 11,
      "tag": null,
      "text": "Kamu menahan napas.",
      "start": 36.155,
      "end": 37.2,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 12,
      "tag": null,
      "text": "Beberapa detik kemudian, langkah itu menjauh.",
      "start": 37.36,
      "end": 40.365,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 13,
      "tag": null,
      "text": "Persediaanmu tinggal setengah botol air dan sebungkus permen karet. Baterai ponselmu tinggal enam puluh persen.",
      "start": 40.525,
      "end": 46.93,
      "retries": 2,
      "status": "accepted-with-warnings"
    },
    {
      "index": 14,
      "tag": null,
      "text": "Kamu berharap bisa bertahan sampai pagi.",
      "start": 47.09,
      "end": 49.215,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 15,
      "tag": null,
      "text": "Jeritan di luar perlahan menghilang.",
      "start": 49.375,
      "end": 51.2,
      "retries": 2,
      "status": "accepted-with-warnings"
    },
    {
      "index": 16,
      "tag": null,
      "text": "Pukul tiga dini hari, kamu mendengar ketukan di kaca.",
      "start": 51.36,
      "end": 54.545,
      "retries": 2,
      "status": "verified"
    },
    {
      "index": 17,
      "tag": null,
      "text": "Tok. Tok.",
      "start": 54.705,
      "end": 56.305,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 18,
      "tag": null,
      "text": "Kamu melihat ke jendela.",
      "start": 56.465,
      "end": 57.53,
      "retries": 2,
      "status": "accepted-with-warnings"
    },
    {
      "index": 19,
      "tag": null,
      "text": "Tidak ada siapa-siapa.",
      "start": 57.69,
      "end": 59.015,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 20,
      "tag": null,
      "text": "Lalu ketukan itu terdengar lagi.",
      "start": 59.175,
      "end": 60.76,
      "retries": 2,
      "status": "accepted-with-warnings"
    },
    {
      "index": 21,
      "tag": null,
      "text": "Kali ini, dari belakang kepalamu.",
      "start": 60.92,
      "end": 63.625,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 22,
      "tag": null,
      "text": "Kamu perlahan menoleh.",
      "start": 63.785,
      "end": 64.99,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 23,
      "tag": null,
      "text": "Seseorang duduk di kursi belakang.",
      "start": 65.15,
      "end": 66.855,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 24,
      "tag": null,
      "text": "Wajahnya pucat. Matanya menatapmu.",
      "start": 67.015,
      "end": 69.46,
      "retries": 2,
      "status": "accepted-with-warnings"
    },
    {
      "index": 25,
      "tag": null,
      "text": "Dia sudah terinfeksi.",
      "start": 69.62,
      "end": 70.785,
      "retries": 0,
      "status": "verified"
    }
  ],
