  "master": true,
  "chunks": [
    {
      "index": 0,
      "tag": "hook",
      "text": "Kalau kaca diketuk, jangan langsung menoleh. Saat wabah menutup jalan tol, dua langkah ini bisa menyembunyikanmu. Satu bunyi bisa membuatmu salah melihat arah.",
      "start": 0,
      "end": 10.485,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 1,
      "tag": "tactical",
      "text": "Pertama, kunci semua pintu. Mobil di depan dan belakang sudah rapat. Gagang pintu tinggal sejengkal dari tanganmu saat seseorang diterkam di sela mobil.",
      "start": 10.745,
      "end": 23.13,
      "retries": 2,
      "status": "failed"
    },
    {
      "index": 2,
      "tag": "tactical",
      "text": "Tarik tanganmu. Tekan kunci. Kalau mobil tak bisa maju, pintu tertutup itu satu-satunya batas antara kamu dan jalan.",
      "start": 23.29,
      "end": 32.855,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 3,
      "tag": "tactical",
      "text": "Kedua, hilangkan tanda kalau ada orang di dalam. Matikan mesin, lampu, dan radio. Turunkan badan sampai garis jendela ada di atas kepalamu.",
      "start": 33.115,
      "end": 46.06,
      "retries": 0,
      "status": "verified"
    },
    {
      "index": 4,
      "tag": "tactical",
      "text": "Kalau langkah berhenti di samping pintu, biarkan bayangannya lewat dulu. Air tinggal setengah botol, baterai enam puluh persen. Kamu cuma perlu bertahan sampai pagi.",
      "start": 46.22,
      "end": 59.465,
      "retries": 1,
      "status": "verified"
    },
    {
      "index": 5,
      "tag": "twist",
      "text": "Pukul tiga pagi, jalan akhirnya sunyi. Jendelanya kosong. Yang mengetuk duduk tepat di belakangmu.",
      "start": 59.915,
      "end": 73.68,
      "retries": 2,
      "status": "failed"
    }
  ],
